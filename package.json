{
  "name": "@local/dsh-mcp-server",
  "version": "0.11.2",
  "type": "module",
  "description": "Expose DeepSeek Harness sessions, agents, and tools to any other agent harness over the Model Context Protocol.",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baitouwuya/dsh-mcp-server.git"
  },
  "homepage": "https://github.com/baitouwuya/dsh-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/baitouwuya/dsh-mcp-server/issues"
  },
  "author": "baitouwuya",
  "meta": {
    "title": "DSH MCP Server",
    "description": "Serves a Model Context Protocol (MCP) endpoint from the running DeepSeek Harness host, so other agent harnesses can start DSH sessions, continue them, and read their transcripts."
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-mcp-stdio": "./bin/dsh-mcp-stdio.mjs"
  },
  "scripts": {
    "test": "node test/mcp-self-test.mjs && node test/plugin-integration-test.mjs && node test/client-half-test.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "locale",
    "icon.svg",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
